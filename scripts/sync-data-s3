#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  scripts/sync-data-s3 upload [S3_URI] [--dry-run] [--delete] [--profile PROFILE]
  scripts/sync-data-s3 download [S3_URI] [--dry-run] [--delete] [--profile PROFILE]

S3_URI may also be supplied with SWACANATASE_DATA_S3_URI.

Examples:
  SWACANATASE_DATA_S3_URI=s3://my-bucket/swacanatase/data scripts/sync-data-s3 upload
  scripts/sync-data-s3 upload s3://my-bucket/swacanatase/data --dry-run
  scripts/sync-data-s3 download s3://my-bucket/swacanatase/data

Notes:
  --delete removes files at the destination that are absent from the source.
  Use --dry-run before --delete unless you are intentionally pruning backups.
EOF
}

if [[ $# -lt 1 ]]; then
  usage
  exit 2
fi

action="$1"
shift

case "$action" in
  upload|download)
    ;;
  -h|--help|help)
    usage
    exit 0
    ;;
  *)
    echo "Unknown action: $action" >&2
    usage >&2
    exit 2
    ;;
esac

s3_uri="${SWACANATASE_DATA_S3_URI:-}"
dry_run=false
delete=false
profile_args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      dry_run=true
      shift
      ;;
    --delete)
      delete=true
      shift
      ;;
    --profile)
      if [[ $# -lt 2 ]]; then
        echo "--profile requires a value" >&2
        exit 2
      fi
      profile_args=(--profile "$2")
      shift 2
      ;;
    s3://*)
      if [[ -n "$s3_uri" && "$s3_uri" != "$1" ]]; then
        echo "S3 URI supplied twice: $s3_uri and $1" >&2
        exit 2
      fi
      s3_uri="$1"
      shift
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ -z "$s3_uri" ]]; then
  echo "Missing S3 URI. Pass s3://... or set SWACANATASE_DATA_S3_URI." >&2
  exit 2
fi

repo_root="$(git rev-parse --show-toplevel)"
local_data="${repo_root}/data"
mkdir -p "$local_data"

sync_args=()
if [[ "$dry_run" == true ]]; then
  sync_args+=(--dryrun)
fi
if [[ "$delete" == true ]]; then
  sync_args+=(--delete)
fi

if [[ "$action" == "upload" ]]; then
  source_path="${local_data}/"
  dest_path="${s3_uri%/}/"
else
  source_path="${s3_uri%/}/"
  dest_path="${local_data}/"
fi

aws "${profile_args[@]}" s3 sync "$source_path" "$dest_path" "${sync_args[@]}"
